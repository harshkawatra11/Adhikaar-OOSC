# Copy this file to .env.local and fill in your own key. Nothing in this
# repository requires a key to run: the jurisdiction engine, the legality
# linter, the deadline clock, and PDF export are all deterministic code
# and work without one. A key only turns on two additive features, the
# plain-language translation and the optional Gemini-phrased rewrite,
# both described on the Methodology page.

# From Google AI Studio (aistudio.google.com/apikey), wired to the
# Gemini API in your Google Cloud project.
GEMINI_API_KEY=

# Optional. The app already tries gemini-3.7-flash, then gemini-3.6-flash,
# then gemini-2.5-flash automatically (src/lib/gemini/client.ts) so a
# single model being unavailable or renamed does not take the AI
# features down. Set this only to force a specific model ahead of that
# built-in chain, for example during testing.
GEMINI_MODEL=

# Optional. Firestore persistence for cases, the intended production
# backend. Without these three set, the app falls back automatically to
# a local JSON file store (see src/lib/store.ts), which is all you need
# to run and test the product. Set these only if you have provisioned
# your own Firestore database and a service account scoped to
# roles/datastore.user against it; see src/lib/firestore/client.ts for
# what the app expects the account to be able to do (nothing beyond
# reading and writing the "cases" collection).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Auth: citizen accounts. Required for sign-in to work at all;
# without these, /login still renders but every sign-in attempt fails
# with a clear message rather than a crash. These four values come from
# the Firebase Console (Project settings > General > Your apps > Web
# app > SDK setup and configuration > Config) or from the Firebase
# Management API, and are public client identifiers, not secrets: the
# security boundary is the admin SDK and this app's own session cookie,
# never the browser talking to Firestore directly (it never does).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Real secret. Signs the app's own session cookie (see
# src/lib/auth/session.ts) after Firebase verifies the sign-in.
# Deliberately NOT a Firebase session cookie: the service account above
# is scoped to roles/datastore.user only and cannot mint one. Generate
# with `openssl rand -hex 32`.
SESSION_SECRET=

# The one-click demo login shown on /login. The password is
# deliberately public, since it is printed on the page itself for
# judges to see. Create this account once via the Firebase Console
# (Authentication > Users > Add user) or the Identity Toolkit
# accounts:signUp REST endpoint, then copy its uid into DEMO_UID below;
# do not use admin.auth().getUserByEmail() to look it up at runtime,
# since that call needs more than the roles/datastore.user permission
# this project's service account deliberately holds.
NEXT_PUBLIC_DEMO_EMAIL=demo@adhikaar.in
NEXT_PUBLIC_DEMO_PASSWORD=
DEMO_UID=

# Bearer token the daily deadline-sweep cron (WP8) must present.
# Vercel sends this header automatically for its own Cron Jobs once
# this variable is set in the project's environment; generate with
# `openssl rand -hex 32`.
CRON_SECRET=
