# Copy this file to .env.local and fill in your own key. Nothing in this
# repository requires a key to run: the jurisdiction engine, the legality
# linter, the deadline clock, and PDF export are all deterministic code
# and work without one. A key only turns on two additive features, the
# plain-language translation and the optional Gemini-phrased rewrite,
# both described on the Methodology page.

# From Google AI Studio (aistudio.google.com/apikey), wired to the
# Gemini API in your Google Cloud project.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash if unset. Override once your
# project has access to a newer model, for example gemini-3.7-flash.
GEMINI_MODEL=

# Optional. Firestore persistence for cases, the intended production
# backend. Without these three set, the app falls back automatically to
# a local JSON file store (see src/lib/store.ts), which is all you need
# to run and test the product. Set these only if you have provisioned
# your own Firestore database and a service account scoped to
# roles/datastore.user against it; see src/lib/firestore/client.ts for
# what the app expects the account to be able to do (nothing beyond
# reading and writing the "cases" collection).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
